# Salin ke .env.local lalu isi password PostgreSQL Anda.
# PostgreSQL 14 di komputer ini berjalan di port 5433.
DATABASE_URL=postgres://postgres:ISI_PASSWORD@localhost:5433/db_koperasi

# Password awal akun internal (owner/admin/petugas) saat db:seed — hanya untuk pengembangan.
SEED_PASSWORD=ganti-dengan-password-dev
